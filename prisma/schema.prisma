generator client {
  provider = "prisma-client-js"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model ContactLead {
  id          String   @id @default(cuid())
  name        String
  email       String
  company     String   @default("")
  service     String   @default("")
  message     String
  status      String   @default("new")
  notes       String   @default("")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// ─── Deal Desk ────────────────────────────────────────────────────────────────
// Reverse-sourcing / brand-acquisition pipeline. A prospect is a brand we want
// a wholesale relationship with; each prospect holds one or more candidate
// products (ASINs) that get scored against the 20-point rubric.

model BrandProspect {
  id            String   @id @default(cuid())
  brandName     String
  website       String   @default("")
  contactName   String   @default("")
  contactEmail  String   @default("")
  contactPhone  String   @default("")
  category      String   @default("")
  stage         String   @default("sourced")
  // sourced | researched | contacted | replied | negotiating | account_open | active | passed
  source        String   @default("manual")
  // manual | smartscout | competitor_scan | referral
  archiveReason String   @default("")
  // bad_price | low_score | no_response | denial | hazmat | restricted | other
  notes         String   @default("")
  firstEmailAt  DateTime?
  secondEmailAt DateTime?
  products      ProspectProduct[]
  emails        OutreachEmail[]
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

// Outreach sequence — TWF-style reverse-sourcing cadence (initial contact →
// follow-ups → situational replies), with the Vertex Channels value prop
// (multi-channel placement + excess-inventory recovery) woven into the copy.

model EmailTemplate {
  id        String   @id @default(cuid())
  key       String   @unique
  name      String
  subject   String
  body      String
  step      Int      @default(0) // 1..n = position in the auto-sequence; 0 = situational, sent on demand
  waitDays  Int      @default(0) // days after the previous step before this one is "due"
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model OutreachEmail {
  id           String   @id @default(cuid())
  prospectId   String
  prospect     BrandProspect @relation(fields: [prospectId], references: [id], onDelete: Cascade)
  templateKey  String   @default("")
  step         Int      @default(0)
  toEmail      String   @default("")
  subject      String
  body         String
  status       String   @default("draft") // draft | sent | logged | skipped
  sentAt       DateTime?
  outcome      String   @default("")       // "" | replied | interested | denied | no_sellers | bounced
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([prospectId])
}

model ProspectProduct {
  id         String        @id @default(cuid())
  prospectId String
  prospect   BrandProspect @relation(fields: [prospectId], references: [id], onDelete: Cascade)

  asin       String
  title      String  @default("")
  productUrl String  @default("")

  // Market snapshot — populated by Keepa or entered manually
  primeLowPrice Float?
  unitsPerMonth Float?
  reviewCount   Int?
  rating        Float?
  sellerCount   Int?      // current competitive sellers, excluding us
  amazonIsSeller               Boolean?
  priceStable90d               Boolean?
  salesStable90d               Boolean?
  merchantFulfilledControlsBB  Boolean?
  suppressedBuyBox             Boolean?
  snapshotSource String   @default("manual") // keepa | junglescout | manual
  snapshotAt     DateTime?

  // Manual review toggles — things a data feed can't answer reliably
  manufacturerOnListing Boolean?
  brandRestricted       Boolean?
  isThirdPartyBundle    Boolean?
  isMultipack           Boolean?
  hasFragileItems       Boolean?
  hazmat                Boolean?

  // Deal economics
  buyCost         Float?
  prepCost        Float?
  shipCostPerUnit Float?
  targetRoi       Float?   // fraction, e.g. 0.30
  fbaFee          Float?   // $ pick & pack — from Keepa when available
  referralRate    Float?   // fraction — from Keepa when available

  // Computed
  score       Int?
  gatesStatus String  @default("incomplete") // pass | fail | incomplete
  band        String  @default("")           // high_priority | contact | archive
  scoreDetail Json?
  scoredAt    DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([prospectId])
}

model TargetSeller {
  id            String   @id @default(cuid())
  sellerName    String
  sellerId      String   @default("")
  storefrontUrl String   @default("")
  notes         String   @default("")
  lastScoutedAt DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}
